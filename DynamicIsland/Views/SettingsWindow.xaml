<Window x:Class="DynamicIsland.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Dynamic Island" Height="680" Width="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality">

  <!-- Modal Outer Container -->
  <Grid Margin="16" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <!-- iOS 18 Modal Sheet Card -->
    <Border Background="#0E0F12" BorderBrush="#25FFFFFF" BorderThickness="1"
            CornerRadius="24" ClipToBounds="True">
      <Border.Effect>
        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.65" Color="Black" Direction="270" />
      </Border.Effect>

      <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
          <!-- Top Header Bar -->
          <RowDefinition Height="Auto" />
          <!-- Scrollable Grouped Settings -->
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="4,0,4,14">
          <TextBlock Text="Настройки" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
          <Button x:Name="BtnDone" Content="Готово" Style="{StaticResource AppleIconButton}"
                  Foreground="#0A84FF" FontSize="15" FontWeight="SemiBold"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnSave_Click" />
        </Grid>

        <!-- Scrollable Settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,8,0">

            <!-- ==================== GROUP 1: APPEARANCE ==================== -->
            <TextBlock Text="ВНЕШНИЙ ВИД" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="8,0,0,6" />
            <Border Background="#18191E" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,0,0,16">
              <StackPanel>
                <!-- Theme Preset -->
                <Grid Margin="0,2,0,10">
                  <TextBlock Text="Тема оформления" FontSize="13.5" FontWeight="Medium" Foreground="#FFFFFF" VerticalAlignment="Center" />
                  <ComboBox x:Name="ComboThemePreset" Width="190" Height="28" HorizontalAlignment="Right"
                            Background="#25262C" Foreground="#FFFFFF" BorderBrush="#35FFFFFF"
                            SelectionChanged="ComboThemePreset_SelectionChanged" />
                </Grid>

                <Separator Background="#22FFFFFF" Margin="0,6,0,8" />

                <!-- Scale Slider -->
                <Grid Margin="0,6">
                  <TextBlock x:Name="LblScale" Text="Масштаб острова: 100%" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                  <Slider x:Name="SliderScale" Style="{StaticResource AppleScrubberSlider}" Width="160" Minimum="80" Maximum="140" Value="100"
                          HorizontalAlignment="Right" ValueChanged="SliderScale_ValueChanged" />
                </Grid>

                <!-- Top Offset Slider -->
                <Grid Margin="0,6">
                  <TextBlock x:Name="LblTopOffset" Text="Отступ сверху: 10 px" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                  <Slider x:Name="SliderTopOffset" Style="{StaticResource AppleScrubberSlider}" Width="160" Minimum="0" Maximum="60" Value="10"
                          HorizontalAlignment="Right" ValueChanged="SliderTopOffset_ValueChanged" />
                </Grid>

                <Separator Background="#22FFFFFF" Margin="0,6,0,8" />

                <!-- iOS Toggle: Acrylic Blur -->
                <CheckBox x:Name="ChkAcrylicBlur" Content="Матовое стекло (Acrylic Blur)" Style="{StaticResource iOSToggleSwitchStyle}" />
                <!-- iOS Toggle: Aura Glow -->
                <CheckBox x:Name="ChkAuraGlow" Content="Неоновое свечение (Aura Glow)" Style="{StaticResource iOSToggleSwitchStyle}" />
                <!-- iOS Toggle: Ambient Shadow -->
                <CheckBox x:Name="ChkShowShadow" Content="Мягкая тень Apple Shadow" Style="{StaticResource iOSToggleSwitchStyle}" />
              </StackPanel>
            </Border>

            <!-- ==================== GROUP 2: BEHAVIOR ==================== -->
            <TextBlock Text="ПОВЕДЕНИЕ" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="8,0,0,6" />
            <Border Background="#18191E" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,0,0,16">
              <StackPanel>
                <CheckBox x:Name="ChkExpandOnHover" Content="Раскрывать при наведении мыши" Style="{StaticResource iOSToggleSwitchStyle}" />
              </StackPanel>
            </Border>

            <!-- ==================== GROUP 3: WIDGET MODULES ==================== -->
            <TextBlock Text="АКТИВНЫЕ МОДУЛИ" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="8,0,0,6" />
            <Border Background="#18191E" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,0,0,16">
              <StackPanel>
                <CheckBox x:Name="ChkWidgetMusic" Content="Медиаплеер (Spotify, Яндекс, YouTube)" Style="{StaticResource iOSToggleSwitchStyle}" />
                <Separator Background="#22FFFFFF" Margin="0,4" />
                <CheckBox x:Name="ChkWidgetVolume" Content="Индикатор и слайдер громкости" Style="{StaticResource iOSToggleSwitchStyle}" />
                <Separator Background="#22FFFFFF" Margin="0,4" />
                <CheckBox x:Name="ChkWidgetClock" Content="Часы и секундомер" Style="{StaticResource iOSToggleSwitchStyle}" />
                <Separator Background="#22FFFFFF" Margin="0,4" />
                <CheckBox x:Name="ChkWidgetWeather" Content="Погода и прогноз" Style="{StaticResource iOSToggleSwitchStyle}" />
                <Separator Background="#22FFFFFF" Margin="0,4" />
                <CheckBox x:Name="ChkWidgetStats" Content="Мониторинг ПК (CPU, RAM, Батарея)" Style="{StaticResource iOSToggleSwitchStyle}" />
                <Separator Background="#22FFFFFF" Margin="0,4" />
                <CheckBox x:Name="ChkWidgetShelf" Content="Временная полка файлов (AirDrop)" Style="{StaticResource iOSToggleSwitchStyle}" />
              </StackPanel>
            </Border>

            <!-- ==================== GROUP 4: WEATHER SETTINGS ==================== -->
            <TextBlock Text="ПОГОДА" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="8,0,0,6" />
            <Border Background="#18191E" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,0,0,16">
              <Grid>
                <TextBlock Text="Город:" FontSize="13.5" FontWeight="Medium" Foreground="#FFFFFF" VerticalAlignment="Center" />
                <TextBox x:Name="TxtWeatherCity" Width="180" Height="28" HorizontalAlignment="Right"
                         Background="#25262C" Foreground="#FFFFFF" BorderBrush="#35FFFFFF" Padding="6,4" />
              </Grid>
            </Border>

            <!-- Hidden compatibility fields -->
            <StackPanel Visibility="Collapsed">
              <TextBox x:Name="TxtBgColor" />
              <TextBox x:Name="TxtBorderColor" />
              <TextBox x:Name="TxtAccentColor" />
              <Slider x:Name="SliderOpacity" />
              <Slider x:Name="SliderRadius" />
              <TextBlock x:Name="LblOpacity" />
              <TextBlock x:Name="LblRadius" />
              <CheckBox x:Name="ChkWidgetNotification" />
              <Button x:Name="BtnCancel" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
