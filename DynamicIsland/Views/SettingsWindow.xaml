<Window x:Class="DynamicIsland.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Dynamic Island" Height="680" Width="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#121418" Foreground="#F0F0F0"
        FontFamily="Segoe UI, Segoe UI Variable Text">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="#AAAAAA" />
      <Setter Property="BorderBrush" Value="#2A2F38" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EEEEEE" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,4" />
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="⚙️ Настройки Dynamic Island" FontSize="20" FontWeight="Bold" Foreground="White" />
      <TextBlock Text="Настройте внешний вид, темы, размеры и активные виджеты" FontSize="12.5" Foreground="#888888" Margin="0,4,0,0" />
    </StackPanel>

    <!-- Scrollable Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">

        <!-- 1. ТЕМЫ И СТИЛЬ -->
        <GroupBox Header=" Внешний вид и Темы ">
          <StackPanel>
            <TextBlock Text="Выберите готовую тему:" Margin="0,0,0,6" />
            <ComboBox x:Name="ComboThemePreset" Height="32" Background="#1E232B" Foreground="Black"
                      SelectionChanged="ComboThemePreset_SelectionChanged" Margin="0,0,0,14" />

            <Separator Background="#2A2F38" Margin="0,6,0,12" />

            <TextBlock Text="Собственная кастомизация (Custom):" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />

            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Цвет фона (HEX, например #000000):" VerticalAlignment="Center" />
              <TextBox x:Name="TxtBgColor" Grid.Column="1" Height="26" Background="#1E232B" Foreground="White" BorderBrush="#3A404D" />
            </Grid>

            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Цвет рамки (HEX):" VerticalAlignment="Center" />
              <TextBox x:Name="TxtBorderColor" Grid.Column="1" Height="26" Background="#1E232B" Foreground="White" BorderBrush="#3A404D" />
            </Grid>

            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Цвет акцента (кнопки, индикаторы):" VerticalAlignment="Center" />
              <TextBox x:Name="TxtAccentColor" Grid.Column="1" Height="26" Background="#1E232B" Foreground="White" BorderBrush="#3A404D" />
            </Grid>

            <TextBlock x:Name="LblOpacity" Text="Непрозрачность: 95%" Margin="0,8,0,0" />
            <Slider x:Name="SliderOpacity" Minimum="20" Maximum="100" Value="95" ValueChanged="SliderOpacity_ValueChanged" />

            <TextBlock x:Name="LblRadius" Text="Скругление углов: 18 px" Margin="0,8,0,0" />
            <Slider x:Name="SliderRadius" Minimum="0" Maximum="26" Value="18" ValueChanged="SliderRadius_ValueChanged" />

            <CheckBox x:Name="ChkAcrylicBlur" Content="Аппаратное матовое стекло (Acrylic blur Windows 10)" Margin="0,8,0,4" />
            <CheckBox x:Name="ChkAuraGlow" Content="Включить неоновое свечение (Aura Glow)" Margin="0,4" />
          </StackPanel>
        </GroupBox>

        <!-- 2. РАЗМЕРЫ И РАСПОЛОЖЕНИЕ -->
        <GroupBox Header=" Размеры и геометрия ">
          <StackPanel>
            <TextBlock x:Name="LblScale" Text="Общий масштаб: 100%" />
            <Slider x:Name="SliderScale" Minimum="80" Maximum="140" Value="100" ValueChanged="SliderScale_ValueChanged" />

            <TextBlock x:Name="LblTopOffset" Text="Отступ от верхнего края экрана: 10 px" Margin="0,8,0,0" />
            <Slider x:Name="SliderTopOffset" Minimum="0" Maximum="60" Value="10" ValueChanged="SliderTopOffset_ValueChanged" />
          </StackPanel>
        </GroupBox>

        <!-- 3. ПОВЕДЕНИЕ -->
        <GroupBox Header=" Поведение ">
          <StackPanel>
            <CheckBox x:Name="ChkExpandOnHover" Content="Раскрывать островок при наведении мыши" IsChecked="True" />
            <CheckBox x:Name="ChkShowShadow" Content="Отображать мягкую тень под островком" IsChecked="True" />
          </StackPanel>
        </GroupBox>

        <!-- 4. АКТИВНЫЕ ВИДЖЕТЫ -->
        <GroupBox Header=" Активные виджеты ">
          <StackPanel>
            <CheckBox x:Name="ChkWidgetMusic" Content="🎵 Медиаплеер (Spotify, Яндекс.Музыка, YouTube)" IsChecked="True" />
            <CheckBox x:Name="ChkWidgetVolume" Content="🔊 Всплывающий индикатор громкости" IsChecked="True" />
            <CheckBox x:Name="ChkWidgetClock" Content="⏱️ Часы, календарь и секундомер" IsChecked="True" />
            <CheckBox x:Name="ChkWidgetWeather" Content="🌤️ Погода (авто-обновление через Open-Meteo)" IsChecked="True" />
            <Grid Margin="24,2,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Город:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AAAAAA" />
              <TextBox x:Name="TxtWeatherCity" Grid.Column="1" Height="24" Background="#1E232B" Foreground="White" BorderBrush="#3A404D" Text="Москва" />
            </Grid>
            <CheckBox x:Name="ChkWidgetStats" Content="⚡ Мониторинг процессора, памяти и батареи" IsChecked="True" />
            <CheckBox x:Name="ChkWidgetShelf" Content="📁 Временная полка файлов (Drag &amp; Drop)" IsChecked="True" />
            <CheckBox x:Name="ChkWidgetNotification" Content="🔔 Уведомления (Telegram, Discord, Windows)" IsChecked="True" />
          </StackPanel>
        </GroupBox>

      </StackPanel>
    </ScrollViewer>

    <!-- Footer Buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BtnCancel" Content="Закрыть" Width="100" Height="32" Margin="0,0,10,0"
              Background="#242933" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click" />
      <Button x:Name="BtnSave" Content="Сохранить и применить" Width="170" Height="32"
              Background="#30D158" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click" />
    </StackPanel>
  </Grid>
</Window>
