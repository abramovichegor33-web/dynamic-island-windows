  <StreamGeometry x:Key="WeatherSunCloudGeometry">M19.35,10.04C18.67,6.59,15.64,4,12,4c-3.72,0-6.85,2.72-7.46,6.31C1.94,10.82,0,13.19,0,16c0,3.31,2.69,6,6,6h13 c2.76,0,5-2.24,5-5C24,13.36,21.95,10.64,19.35,10.04z</StreamGeometry>
