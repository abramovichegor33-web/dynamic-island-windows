<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ========================================================================= -->
  <!-- 1. APPLE iOS 18 SYSTEM COLOR TOKENS                                       -->
  <!-- ========================================================================= -->
  <SolidColorBrush x:Key="IslandPureBlackBrush" Color="#000000" />
  <SolidColorBrush x:Key="IslandRimBorderBrush" Color="#1F1F22" />
  <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#1C1C1E" />
  <SolidColorBrush x:Key="GlassSurfaceHoverBrush" Color="#2C2C2E" />
  <SolidColorBrush x:Key="GlassSurfaceActiveBrush" Color="#3A3A3C" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#48484A" />

  <!-- iOS Accents -->
  <SolidColorBrush x:Key="AccentGreenBrush" Color="#30D158" />
  <SolidColorBrush x:Key="AccentBlueBrush" Color="#0A84FF" />
  <SolidColorBrush x:Key="AccentPurpleBrush" Color="#BF5AF2" />
  <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FF9F0A" />

  <!-- Dynamic compatibility aliases -->
  <SolidColorBrush x:Key="IslandBgBrush" Color="#000000" />
  <SolidColorBrush x:Key="IslandBorderBrush" Color="#1F1F22" />
  <SolidColorBrush x:Key="AccentBrush" Color="#30D158" />
  <SolidColorBrush x:Key="AuraGlowBrush" Color="Transparent" />
  <Thickness x:Key="IslandBorderThickness">1</Thickness>
  <CornerRadius x:Key="IslandCornerRadius">19</CornerRadius>
  <sys:Double x:Key="AuraGlowRadius">0.0</sys:Double>

  <!-- Global Null Focus Visual Style -->
  <Style x:Key="NullFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

