<UserControl x:Class="DynamicIsland.Widgets.NotificationWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid>
    <!-- Compact View -->
    <Grid x:Name="CompactContainer" Height="36" VerticalAlignment="Center" Margin="8,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="🔔" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="CompactApp" Text="Telegram" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="CompactMessage" Text="Новое сообщение" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <TextBlock x:Name="CompactTime" Grid.Column="2" Text="сейчас" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
    </Grid>

    <!-- Expanded View -->
    <Grid x:Name="ExpandedContainer" Visibility="Collapsed" Margin="18,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- App Header -->
      <Grid Grid.Row="0" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="💬" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock x:Name="ExpApp" Text="Telegram" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="ExpTime" Text="12:45" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>

      <!-- Message Content -->
      <StackPanel Grid.Row="1">
        <TextBlock x:Name="ExpTitle" Text="Иван Иванов" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ExpBody" Text="Привет! Как дела с проектом?" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
