<UserControl x:Class="DynamicIsland.Widgets.ClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid>
    <!-- ==================== COMPACT VIEW ==================== -->
    <StackPanel x:Name="CompactContainer" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
      <TextBlock x:Name="TextCompactTime" Text="12:00" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" />
      <TextBlock Text=" • " FontSize="11" Foreground="#8E8E93" />
      <TextBlock x:Name="TextCompactDate" Text="Ср, 18 ноя" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center" />
    </StackPanel>

    <!-- ==================== EXPANDED VIEW (iOS Clock App Style) ==================== -->
    <Grid x:Name="ExpandedContainer" Visibility="Collapsed" Margin="16,8,16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Column: Clock & Calendar -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="TextBigTime" Text="12:00:00" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
        <TextBlock x:Name="TextBigDate" Text="Среда, 18 ноября 2026" FontSize="11.5" Margin="0,4,0,0"
                   Foreground="#8E8E93" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Divider -->
      <Border Grid.Column="1" Width="1" Margin="16,6" Background="#2C2C2E" />

      <!-- Right Column: Stopwatch / Timer -->
      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="СЕКУНДОМЕР" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
        <TextBlock x:Name="TextStopwatch" Text="00:00.0" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button x:Name="BtnSwStartPause" Content="Старт" Width="58" Height="28" FontSize="11"
                  Background="{DynamicResource AccentBrush}" Foreground="#000000" FontWeight="SemiBold"
                  BorderThickness="0" Cursor="Hand" Click="BtnSwStartPause_Click">
            <Button.Resources>
              <Style TargetType="Border"><Setter Property="CornerRadius" Value="14" /></Style>
            </Button.Resources>
          </Button>

          <Button x:Name="BtnSwReset" Content="Сброс" Width="58" Height="28" FontSize="11" Margin="6,0,0,0"
                  Background="#2C2C2E" Foreground="#FFFFFF"
                  BorderThickness="0" Cursor="Hand" Click="BtnSwReset_Click">
            <Button.Resources>
              <Style TargetType="Border"><Setter Property="CornerRadius" Value="14" /></Style>
            </Button.Resources>
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
