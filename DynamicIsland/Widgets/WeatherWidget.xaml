<UserControl x:Class="DynamicIsland.Widgets.WeatherWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid>
    <!-- ==================== COMPACT VIEW ==================== -->
    <StackPanel x:Name="CompactContainer" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
      <TextBlock x:Name="IconCompact" Text="☀️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
      <TextBlock x:Name="TextCompactTemp" Text="+20°C" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
    </StackPanel>

    <!-- ==================== EXPANDED VIEW (iOS Weather Style) ==================== -->
    <Grid x:Name="ExpandedContainer" Visibility="Collapsed" Margin="20,10,20,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Big Weather Icon -->
      <TextBlock x:Name="IconExpanded" Text="☀️" FontSize="46" VerticalAlignment="Center" Margin="0,0,16,0" />

      <!-- Details -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="TextExpTemp" Text="+20°" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF" />
          <TextBlock x:Name="TextCity" Text="Москва" FontSize="14" FontWeight="SemiBold" Foreground="#8E8E93" Margin="10,8,0,0" />
        </StackPanel>
        <TextBlock x:Name="TextDesc" Text="Ясно, без осадков" FontSize="12.5" Margin="0,2,0,0" Foreground="#8E8E93" />
      </StackPanel>

      <!-- iOS Refresh Button -->
      <Button x:Name="BtnRefresh" Grid.Column="2" Content="🔄" Width="36" Height="36" FontSize="14"
              Background="#2C2C2E" Foreground="#FFFFFF" BorderThickness="0"
              Cursor="Hand" VerticalAlignment="Center" Click="BtnRefresh_Click">
        <Button.Resources>
          <Style TargetType="Border"><Setter Property="CornerRadius" Value="18" /></Style>
        </Button.Resources>
      </Button>
    </Grid>
  </Grid>
</UserControl>
