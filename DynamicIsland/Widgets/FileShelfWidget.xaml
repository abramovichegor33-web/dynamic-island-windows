<UserControl x:Class="DynamicIsland.Widgets.FileShelfWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid>
    <!-- ==================== COMPACT VIEW ==================== -->
    <StackPanel x:Name="CompactContainer" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
      <TextBlock Text="📁" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
      <TextBlock x:Name="TextCompactCount" Text="Полка пуста" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center" />
    </StackPanel>

    <!-- ==================== EXPANDED VIEW (iOS Files / AirDrop Style) ==================== -->
    <Grid x:Name="ExpandedContainer" Visibility="Collapsed" Margin="16,8,16,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Grid.Row="0" Margin="0,0,0,8">
        <TextBlock Text="📁 ВРЕМЕННАЯ ПОЛКА ФАЙЛОВ" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" />
        <Button x:Name="BtnClearAll" Content="Очистить всё" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}"
                Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" Click="BtnClearAll_Click" />
      </Grid>

      <!-- List or Empty Placeholder -->
      <Border Grid.Row="1" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1" CornerRadius="12" Padding="8">
        <Grid>
          <TextBlock x:Name="TextPlaceholder" Text="Перетащите сюда любые файлы с рабочего стола"
                     FontSize="12" Foreground="#8E8E93" TextAlignment="Center"
                     VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0" />

          <ListBox x:Name="ListFiles" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Text="📄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                  <Button Grid.Column="2" Content="📋" ToolTip="Скопировать" Background="#2C2C2E" BorderThickness="0"
                          Width="26" Height="26" Margin="4,0" Cursor="Hand" Click="BtnCopyFile_Click" Tag="{Binding Path}">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13" /></Style></Button.Resources>
                  </Button>

                  <Button Grid.Column="3" Content="📂" ToolTip="Открыть папку" Background="#2C2C2E" BorderThickness="0"
                          Width="26" Height="26" Margin="2,0" Cursor="Hand" Click="BtnOpenFile_Click" Tag="{Binding Path}">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13" /></Style></Button.Resources>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
