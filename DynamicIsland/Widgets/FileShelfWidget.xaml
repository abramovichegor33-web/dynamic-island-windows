<UserControl x:Class="DynamicIsland.Widgets.FileShelfWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid>
    <!-- Compact View -->
    <StackPanel x:Name="CompactContainer" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
      <TextBlock Text="📁" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
      <TextBlock x:Name="TextCompactCount" Text="Полка пуста" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Expanded View -->
    <Grid x:Name="ExpandedContainer" Visibility="Collapsed" Margin="16,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Grid.Row="0" Margin="0,0,0,8">
        <TextBlock Text="📁 ВРЕМЕННАЯ ПОЛКА ФАЙЛОВ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
        <Button x:Name="BtnClearAll" Content="Очистить всё" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"
                Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" Click="BtnClearAll_Click" />
      </Grid>

      <!-- List or Empty Placeholder -->
      <Grid Grid.Row="1">
        <TextBlock x:Name="TextPlaceholder" Text="Перетащите сюда любые файлы или папки с рабочего стола"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"
                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0" />

        <ListBox x:Name="ListFiles" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="📄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                <Button Grid.Column="2" Content="📋" ToolTip="Скопировать в буфер" Background="#22FFFFFF" BorderThickness="0"
                        Width="26" Height="26" Margin="4,0" Cursor="Hand" Click="BtnCopyFile_Click" Tag="{Binding Path}" />

                <Button Grid.Column="3" Content="📂" ToolTip="Открыть папку" Background="#22FFFFFF" BorderThickness="0"
                        Width="26" Height="26" Margin="2,0" Cursor="Hand" Click="BtnOpenFile_Click" Tag="{Binding Path}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
