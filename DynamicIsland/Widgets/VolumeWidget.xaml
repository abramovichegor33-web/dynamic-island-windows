<UserControl x:Class="DynamicIsland.Widgets.VolumeWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid>
    <!-- Compact View (Height = 36) -->
    <Grid x:Name="CompactContainer" Height="36" VerticalAlignment="Center" Margin="10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="IconSpeaker" Text="🔊" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />

      <ProgressBar x:Name="VolBar" Grid.Column="1" Height="6" Maximum="100" Value="50"
                   Foreground="{DynamicResource AccentBrush}" Background="#2AFFFFFF" BorderThickness="0">
        <ProgressBar.Resources>
          <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
          </Style>
        </ProgressBar.Resources>
      </ProgressBar>

      <TextBlock x:Name="TextPercent" Grid.Column="2" Text="50%" FontSize="11.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
    </Grid>

    <!-- Expanded View -->
    <Grid x:Name="ExpandedContainer" Visibility="Collapsed" Margin="20,12">
      <StackPanel VerticalAlignment="Center">
        <!-- Top Row: Icon + Title + Mute + Percent -->
        <Grid Margin="0,0,0,14">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnMute" Width="34" Height="34" Background="#22FFFFFF" BorderThickness="0"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" Cursor="Hand" Margin="0,0,10,0"
                    Click="BtnMute_Click">
              <Button.Resources>
                <Style TargetType="Border"><Setter Property="CornerRadius" Value="17" /></Style>
              </Button.Resources>
              <TextBlock x:Name="ExpIcon" Text="🔊" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Громкость динамиков" FontSize="13.5" FontWeight="SemiBold" />
              <TextBlock x:Name="TextMuteStatus" Text="Вывод звука активен" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>

          <TextBlock x:Name="ExpPercent" Text="50%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Slider -->
        <Slider x:Name="ExpSlider" Height="28" Maximum="100" Value="50" IsMoveToPointEnabled="True"
                ValueChanged="ExpSlider_ValueChanged" Margin="0,0,0,12" />

        <!-- Quick Presets -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="0%" Width="44" Height="24" FontSize="10" Margin="4,0" Background="#18FFFFFF" BorderThickness="0"
                  Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" Click="Preset_Click" Tag="0">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12" /></Style></Button.Resources>
          </Button>
          <Button Content="25%" Width="44" Height="24" FontSize="10" Margin="4,0" Background="#18FFFFFF" BorderThickness="0"
                  Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" Click="Preset_Click" Tag="25">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12" /></Style></Button.Resources>
          </Button>
          <Button Content="50%" Width="44" Height="24" FontSize="10" Margin="4,0" Background="#18FFFFFF" BorderThickness="0"
                  Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" Click="Preset_Click" Tag="50">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12" /></Style></Button.Resources>
          </Button>
          <Button Content="75%" Width="44" Height="24" FontSize="10" Margin="4,0" Background="#18FFFFFF" BorderThickness="0"
                  Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" Click="Preset_Click" Tag="75">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12" /></Style></Button.Resources>
          </Button>
          <Button Content="100%" Width="44" Height="24" FontSize="10" Margin="4,0" Background="#18FFFFFF" BorderThickness="0"
                  Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" Click="Preset_Click" Tag="100">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12" /></Style></Button.Resources>
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
