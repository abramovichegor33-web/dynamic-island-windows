<UserControl x:Class="DynamicIsland.Widgets.VolumeWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid>
    <!-- ==================== COMPACT VIEW ==================== -->
    <Grid x:Name="CompactContainer" Height="38" VerticalAlignment="Center" Margin="10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="IconSpeaker" Text="🔊" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />

      <ProgressBar x:Name="VolBar" Grid.Column="1" Height="6" Maximum="100" Value="50"
                   Foreground="{DynamicResource AccentBrush}" Background="#2C2C2E" BorderThickness="0">
        <ProgressBar.Resources>
          <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
          </Style>
        </ProgressBar.Resources>
      </ProgressBar>

      <TextBlock x:Name="TextPercent" Grid.Column="2" Text="50%" FontSize="11.5" FontWeight="SemiBold"
                 Foreground="#FFFFFF" Margin="10,0,0,0" VerticalAlignment="Center" />
    </Grid>

    <!-- ==================== EXPANDED VIEW (iOS Control Center Style) ==================== -->
    <Grid x:Name="ExpandedContainer" Visibility="Collapsed" Margin="20,8,20,12">
      <StackPanel VerticalAlignment="Center">
        <!-- Top Row: Icon + Title + Mute + Percent -->
        <Grid Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnMute" Width="36" Height="36" Background="#2C2C2E" BorderThickness="0"
                    Foreground="#FFFFFF" FontSize="16" Cursor="Hand" Margin="0,0,10,0"
                    Click="BtnMute_Click">
              <Button.Resources>
                <Style TargetType="Border"><Setter Property="CornerRadius" Value="18" /></Style>
              </Button.Resources>
              <TextBlock x:Name="ExpIcon" Text="🔊" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Громкость системы" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
              <TextBlock x:Name="TextMuteStatus" Text="Вывод звука активен" FontSize="11" Foreground="#8E8E93" />
            </StackPanel>
          </StackPanel>

          <TextBlock x:Name="ExpPercent" Text="50%" FontSize="20" FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- iOS Smooth Slider -->
        <Slider x:Name="ExpSlider" Height="28" Maximum="100" Value="50" IsMoveToPointEnabled="True"
                ValueChanged="ExpSlider_ValueChanged" Margin="0,0,0,12" />

        <!-- iOS Quick Presets Capsules -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="0%" Width="46" Height="26" FontSize="10.5" FontWeight="Medium" Margin="4,0"
                  Background="#2C2C2E" BorderThickness="0" Foreground="#FFFFFF" Cursor="Hand" Click="Preset_Click" Tag="0">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13" /></Style></Button.Resources>
          </Button>
          <Button Content="25%" Width="46" Height="26" FontSize="10.5" FontWeight="Medium" Margin="4,0"
                  Background="#2C2C2E" BorderThickness="0" Foreground="#FFFFFF" Cursor="Hand" Click="Preset_Click" Tag="25">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13" /></Style></Button.Resources>
          </Button>
          <Button Content="50%" Width="46" Height="26" FontSize="10.5" FontWeight="Medium" Margin="4,0"
                  Background="#2C2C2E" BorderThickness="0" Foreground="#FFFFFF" Cursor="Hand" Click="Preset_Click" Tag="50">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13" /></Style></Button.Resources>
          </Button>
          <Button Content="75%" Width="46" Height="26" FontSize="10.5" FontWeight="Medium" Margin="4,0"
                  Background="#2C2C2E" BorderThickness="0" Foreground="#FFFFFF" Cursor="Hand" Click="Preset_Click" Tag="75">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13" /></Style></Button.Resources>
          </Button>
          <Button Content="100%" Width="46" Height="26" FontSize="10.5" FontWeight="Medium" Margin="4,0"
                  Background="#2C2C2E" BorderThickness="0" Foreground="#FFFFFF" Cursor="Hand" Click="Preset_Click" Tag="100">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13" /></Style></Button.Resources>
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
