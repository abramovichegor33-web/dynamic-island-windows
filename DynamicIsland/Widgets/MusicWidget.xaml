<UserControl x:Class="DynamicIsland.Widgets.MusicWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid>
    <!-- Compact View -->
    <Grid x:Name="CompactContainer" Height="36" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Mini Album Art / Music Icon -->
      <Border Width="22" Height="22" CornerRadius="11" Margin="6,0,8,0" Background="#22FFFFFF" ClipToBounds="True">
        <Image x:Name="CompactArt" Stretch="UniformToFill" />
      </Border>

      <!-- Track and Artist -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
        <TextBlock x:Name="CompactTitle" Text="Нет трека" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="CompactArtist" Text="" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- Mini Play State Indicator -->
      <TextBlock x:Name="CompactPlayingIndicator" Grid.Column="2" Text="▶" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
    </Grid>

    <!-- Expanded View -->
    <Grid x:Name="ExpandedContainer" Visibility="Collapsed" Margin="16,12,16,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Main Info Row -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Large Album Art -->
        <Border Width="64" Height="64" CornerRadius="12" Background="#2A2A2A" ClipToBounds="True" Margin="0,0,14,0">
          <Image x:Name="ExpandedArt" Stretch="UniformToFill" />
        </Border>

        <!-- Titles -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="ExpandedTitle" Text="Ничего не играет" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="ExpandedArtist" Text="Включите музыку в плеере или браузере" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>

      <!-- Progress Bar -->
      <ProgressBar x:Name="PlaybackProgress" Grid.Row="1" Height="4" Margin="0,14,0,8" Value="0" Maximum="100"
                   Foreground="{DynamicResource AccentBrush}" Background="#33FFFFFF" BorderThickness="0" />

      <!-- Controls Row -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
        <Button x:Name="BtnPrev" Content="⏮" Width="36" Height="36" FontSize="14" Margin="10,0"
                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                Cursor="Hand" Click="BtnPrev_Click" />
        <Button x:Name="BtnPlayPause" Content="⏯" Width="44" Height="44" FontSize="18" Margin="10,0"
                Background="{DynamicResource AccentBrush}" BorderThickness="0" Foreground="Black"
                Cursor="Hand" Click="BtnPlayPause_Click">
          <Button.Resources>
            <Style TargetType="Border">
              <Setter Property="CornerRadius" Value="22" />
            </Style>
          </Button.Resources>
        </Button>
        <Button x:Name="BtnNext" Content="⏭" Width="36" Height="36" FontSize="14" Margin="10,0"
                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                Cursor="Hand" Click="BtnNext_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
