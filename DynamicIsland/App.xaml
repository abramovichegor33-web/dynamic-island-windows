<Application x:Class="DynamicIsland.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Default theme dynamic fallback brushes -->
    <SolidColorBrush x:Key="IslandBgBrush" Color="#FA050505" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#262626" />
    <Thickness x:Key="IslandBorderThickness">1</Thickness>
    <CornerRadius x:Key="IslandCornerRadius">18</CornerRadius>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
    <SolidColorBrush x:Key="AccentBrush" Color="#30D158" />
    <SolidColorBrush x:Key="AuraGlowBrush" Color="Transparent" />
    <sys:Double x:Key="AuraGlowRadius">0.0</sys:Double>
  </Application.Resources>
</Application>
