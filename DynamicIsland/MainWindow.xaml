<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="220" Height="48"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter"
        FontFamily="Segoe UI, Segoe UI Variable Text"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality">

  <Window.ContextMenu>
    <ContextMenu Background="#181B20" Foreground="White" BorderBrush="#333333">
      <MenuItem Header="⚙️ Настройки..." Click="MenuSettings_Click" />
      <MenuItem Header="🎨 Следующая тема" Click="MenuNextTheme_Click" />
      <MenuItem Header="🎯 Центрировать на экране" Click="MenuRecenter_Click" />
      <Separator Background="#333333" />
      <MenuItem Header="❌ Выход" Click="MenuExit_Click" />
    </ContextMenu>
  </Window.ContextMenu>

  <!-- Root Container -->
  <Grid x:Name="RootGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="6">
    
    <!-- Aura Glow (Conditional) -->
    <Border x:Name="AuraGlow" CornerRadius="{DynamicResource IslandCornerRadius}"
            Background="{DynamicResource AuraGlowBrush}" Opacity="0.5"
            Margin="-4" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="16" />
      </Border.Effect>
    </Border>

    <!-- Main Island Capsule -->
    <Border x:Name="IslandPill"
            Background="{DynamicResource IslandBgBrush}"
            BorderBrush="{DynamicResource IslandBorderBrush}"
            BorderThickness="{DynamicResource IslandBorderThickness}"
            CornerRadius="{DynamicResource IslandCornerRadius}"
            ClipToBounds="True">
      
      <!-- Soft Shadow -->
      <Border.Effect>
        <DropShadowEffect x:Name="PillShadow" BlurRadius="22" ShadowDepth="4" Opacity="0.45" Color="Black" Direction="270" />
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Expanded Header Tabs Bar (Visible only when expanded) -->
        <Grid x:Name="HeaderTabs" Grid.Row="0" Visibility="Collapsed" Height="32" Margin="10,6,10,2">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Dynamically populated widget icon buttons -->
            </StackPanel>
          </ScrollViewer>

          <!-- Settings gear icon button in top-right -->
          <Button x:Name="BtnHeaderSettings" Content="⚙️" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Width="26" Height="26" FontSize="12" Background="#18FFFFFF" BorderThickness="0"
                  Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" ToolTip="Настройки Dynamic Island"
                  Click="MenuSettings_Click">
            <Button.Resources>
              <Style TargetType="Border"><Setter Property="CornerRadius" Value="13" /></Style>
            </Button.Resources>
          </Button>
        </Grid>

        <!-- Active Widget Content -->
        <ContentControl x:Name="WidgetHost" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

      </Grid>
    </Border>

  </Grid>
</Window>
