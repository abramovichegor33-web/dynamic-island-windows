<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="480" Height="250"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality">

  <Window.ContextMenu>
    <ContextMenu Background="{StaticResource GlassSurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                 BorderBrush="{StaticResource GlassSurfaceHoverBrush}" BorderThickness="1">
      <MenuItem Header="⚙️ Настройки Dynamic Island..." Click="MenuSettings_Click" />
      <MenuItem Header="🎯 Центрировать на экране" Click="MenuRecenter_Click" />
      <Separator Background="{StaticResource GlassSurfaceHoverBrush}" />
      <MenuItem Header="❌ Закрыть" Click="MenuExit_Click" />
    </ContextMenu>
  </Window.ContextMenu>

  <!-- Canvas Root (Null Background passes clicks through to desktop windows) -->
  <Grid x:Name="RootGrid" Background="{x:Null}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <!-- Aura Glow (Conditional subtle backlight) -->
    <Border x:Name="AuraGlow"
            Width="216" Height="38"
            CornerRadius="19"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,10,0,0"
            Background="{StaticResource AccentGreenBrush}" Opacity="0.4"
            IsHitTestVisible="False" Visibility="Collapsed">
      <Border.Effect>
        <BlurEffect Radius="24" />
      </Border.Effect>
    </Border>

    <!-- Main Island Capsule (Hardware-Accelerated In-Place GPU Morphing) -->
    <Border x:Name="IslandPill"
            Width="216" Height="38"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,10,0,0"
            MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
            MouseLeftButtonDown="Pill_MouseLeftButtonDown"
            MouseWheel="Pill_MouseWheel"
            Background="{StaticResource IslandPureBlackBrush}"
            BorderBrush="{StaticResource IslandRimBorderBrush}"
            BorderThickness="1"
            CornerRadius="19"
            ClipToBounds="True">
      
      <!-- Apple Diffused Ambient Shadow -->
      <Border.Effect>
        <DropShadowEffect x:Name="PillShadow" BlurRadius="26" ShadowDepth="4" Opacity="0.45" Color="Black" Direction="270" />
      </Border.Effect>

      <Grid>
        <!-- ================================================================= -->
        <!-- 1. COMPACT PILL STATE (Height=38, Width=216, CornerRadius=19)     -->
        <!-- ================================================================= -->
        <Grid x:Name="CompactContainer" Height="38" VerticalAlignment="Center" Margin="7,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Left: Mini Artwork (24x24) with Apple Music Fallback -->
          <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource GlassSurfaceBrush}"
                  BorderBrush="#25FFFFFF" BorderThickness="0.8" ClipToBounds="True" Margin="0,0,8,0">
            <Grid>
              <Border Background="#252528">
                <Viewbox Width="12" Height="12" Stretch="Uniform">
                  <Path Data="{StaticResource MusicNoteGeometry}" Fill="{StaticResource TextSecondaryBrush}" />
                </Viewbox>
              </Border>
              <Image x:Name="CompactArt" Stretch="UniformToFill" />
            </Grid>
          </Border>

          <!-- Center: Truncated Track Title & Artist -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock x:Name="CompactTitle" Text="Музыка не играет" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CompactArtist" Text="Включите трек" FontSize="9.5" FontWeight="Normal"
                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0.5,0,0" />
          </StackPanel>

          <!-- Right: 4-Bar Animated Equalizer -->
          <StackPanel x:Name="CompactVisualizer" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
            <Border x:Name="Bar1" Width="2" Height="8" Background="{StaticResource AccentGreenBrush}" CornerRadius="1" Margin="1,0" />
            <Border x:Name="Bar2" Width="2" Height="14" Background="{StaticResource AccentGreenBrush}" CornerRadius="1" Margin="1,0" />
            <Border x:Name="Bar3" Width="2" Height="6" Background="{StaticResource AccentGreenBrush}" CornerRadius="1" Margin="1,0" />
            <Border x:Name="Bar4" Width="2" Height="11" Background="{StaticResource AccentGreenBrush}" CornerRadius="1" Margin="1,0" />
          </StackPanel>
        </Grid>

        <!-- ================================================================= -->
        <!-- 2. EXPANDED VIEW STATE (Pure Apple iOS 18 Media Player)           -->
        <!-- Width=430, Height=186, CornerRadius=36                            -->
        <!-- ================================================================= -->
        <Grid x:Name="ExpandedContainer" Visibility="Collapsed" Margin="22,16,22,16">
          <Grid.RowDefinitions>
            <!-- Row 0: Artwork + Titles + Live Waveform (Height: 56) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Scrubber Slider + Timestamps (Height: 32) -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Playback Transport Controls (Height: 44) -->
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Row 0: Artwork + Titles + Live Waveform -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 56x56 Album Artwork with Apple Music gradient fallback -->
            <Border Width="56" Height="56" CornerRadius="13" Background="{StaticResource GlassSurfaceBrush}"
                    BorderBrush="#25FFFFFF" BorderThickness="1" ClipToBounds="True" Margin="0,0,14,0">
              <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="Black" />
              </Border.Effect>
              <Grid>
                <!-- Fallback tile -->
                <Border>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#FA233B" Offset="0.0" />
                      <GradientStop Color="#FB5C74" Offset="1.0" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Viewbox Width="26" Height="26" Stretch="Uniform">
                    <Path Data="{StaticResource MusicNoteGeometry}" Fill="#FFFFFF" />
                  </Viewbox>
                </Border>
                <Image x:Name="ExpandedArt" Stretch="UniformToFill" />
              </Grid>
            </Border>

            <!-- Track Details (Vertically centered with Artwork) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock x:Name="ExpandedTitle" Text="Ничего не воспроизводится" FontSize="15.5" FontWeight="Bold"
                         Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ExpandedArtist" Text="Запустите Spotify, Яндекс или браузер" FontSize="12" FontWeight="Normal"
                         Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            </StackPanel>

            <!-- 5-Bar Live Waveform Visualizer -->
            <StackPanel x:Name="ExpVisualizer" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="ExpBar1" Width="3" Height="12" Background="{StaticResource AccentGreenBrush}" CornerRadius="1.5" Margin="1.5,0" />
              <Border x:Name="ExpBar2" Width="3" Height="22" Background="{StaticResource AccentGreenBrush}" CornerRadius="1.5" Margin="1.5,0" />
              <Border x:Name="ExpBar3" Width="3" Height="8" Background="{StaticResource AccentGreenBrush}" CornerRadius="1.5" Margin="1.5,0" />
              <Border x:Name="ExpBar4" Width="3" Height="18" Background="{StaticResource AccentGreenBrush}" CornerRadius="1.5" Margin="1.5,0" />
              <Border x:Name="ExpBar5" Width="3" Height="10" Background="{StaticResource AccentGreenBrush}" CornerRadius="1.5" Margin="1.5,0" />
            </StackPanel>
          </Grid>

          <!-- Row 1: iOS Interactive Scrubber Slider + Timestamps -->
          <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Slider x:Name="PlaybackProgress" Style="{StaticResource AppleScrubberSlider}"
                    Maximum="100" Value="0"
                    PreviewMouseDown="PlaybackProgress_PreviewMouseDown"
                    PreviewMouseUp="PlaybackProgress_PreviewMouseUp"
                    ValueChanged="PlaybackProgress_ValueChanged" />

            <Grid Grid.Row="1" Margin="0,3,0,0">
              <TextBlock x:Name="TextElapsed" Text="0:00" FontSize="10.5" FontWeight="Medium"
                         Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
              <TextBlock x:Name="TextTotal" Text="0:00" FontSize="10.5" FontWeight="Medium"
                         Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
            </Grid>
          </Grid>

          <!-- Row 2: Transport Controls (Centered, generous bottom clearance) -->
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0">
            <!-- Previous Button -->
            <Button x:Name="BtnPrev" Width="40" Height="40" Style="{StaticResource AppleIconButton}"
                    Margin="16,0" Click="BtnPrev_Click" ToolTip="Предыдущий трек">
              <Viewbox Width="18" Height="18" Stretch="Uniform">
                <Path Data="{StaticResource PrevGeometry}" Fill="{StaticResource TextPrimaryBrush}" />
              </Viewbox>
            </Button>

            <!-- Play / Pause Circular Primary Button -->
            <Button x:Name="BtnPlayPause" Style="{StaticResource ApplePrimaryCircleButton}"
                    Width="44" Height="44" Margin="16,0" Click="BtnPlayPause_Click" ToolTip="Воспроизведение / Пауза">
              <Viewbox Width="18" Height="18" Stretch="Uniform" Margin="2,0,0,0">
                <Path x:Name="IconPlayPause" Data="{StaticResource PlayGeometry}" Fill="{StaticResource IslandPureBlackBrush}" />
              </Viewbox>
            </Button>

            <!-- Next Button -->
            <Button x:Name="BtnNext" Width="40" Height="40" Style="{StaticResource AppleIconButton}"
                    Margin="16,0" Click="BtnNext_Click" ToolTip="Следующий трек">
              <Viewbox Width="18" Height="18" Stretch="Uniform">
                <Path Data="{StaticResource NextGeometry}" Fill="{StaticResource TextPrimaryBrush}" />
              </Viewbox>
            </Button>
          </StackPanel>

        </Grid>

      </Grid>
    </Border>

  </Grid>
</Window>
