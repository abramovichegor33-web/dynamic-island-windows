<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dynamic Island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="236" Height="58"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter"
        FontFamily="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality">

  <Window.ContextMenu>
    <ContextMenu Background="{StaticResource GlassSurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                 BorderBrush="{StaticResource GlassSurfaceHoverBrush}" BorderThickness="1">
      <MenuItem Header="⚙️ Настройки..." Click="MenuSettings_Click" />
      <MenuItem Header="🎯 Центрировать на экране" Click="MenuRecenter_Click" />
      <Separator Background="{StaticResource GlassSurfaceHoverBrush}" />
      <MenuItem Header="❌ Выход" Click="MenuExit_Click" />
    </ContextMenu>
  </Window.ContextMenu>

  <!-- Root Container with Shadow Room -->
  <Grid x:Name="RootGrid" Margin="10">

    <!-- Aura Glow (Conditional) -->
    <Border x:Name="AuraGlow" CornerRadius="19"
            Background="{StaticResource AccentGreenBrush}" Opacity="0.4"
            Margin="-4" IsHitTestVisible="False" Visibility="Collapsed">
      <Border.Effect>
        <BlurEffect Radius="22" />
      </Border.Effect>
    </Border>

    <!-- Main Island Capsule (Apple True OLED Black + Hairline Rim Border) -->
    <Border x:Name="IslandPill"
            Width="216" Height="38"
            Background="{StaticResource IslandPureBlackBrush}"
            BorderBrush="{StaticResource IslandRimBorderBrush}"
            BorderThickness="1"
            CornerRadius="19"
            ClipToBounds="True">
      
      <!-- Apple Diffused Ambient Shadow -->
      <Border.Effect>
        <DropShadowEffect x:Name="PillShadow" BlurRadius="28" ShadowDepth="4" Opacity="0.5" Color="Black" Direction="270" />
      </Border.Effect>

      <Grid>
        <!-- ================================================================= -->
        <!-- 1. COMPACT PILL STATE (Height=38, Width=216)                      -->
        <!-- ================================================================= -->
        <Grid x:Name="CompactContainer" Height="38" VerticalAlignment="Center" Margin="6,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Left: Mini Album Cover (24x24 Squircle) -->
          <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource GlassSurfaceBrush}"
                  BorderBrush="#25FFFFFF" BorderThickness="1" ClipToBounds="True" Margin="2,0,8,0">
            <Image x:Name="CompactArt" Stretch="UniformToFill" />
          </Border>

          <!-- Center: Marquee / Truncated Track Title & Artist -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock x:Name="CompactTitle" Text="Музыка не играет" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CompactArtist" Text="Включите трек" FontSize="9.5" FontWeight="Normal"
                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0.5,0,0" />
          </StackPanel>

          <!-- Right: 4-Bar Animated Audio Visualizer -->
          <StackPanel x:Name="CompactVisualizer" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
            <Border x:Name="Bar1" Width="2" Height="8" Background="{StaticResource AccentGreenBrush}" CornerRadius="1" Margin="1,0" />
            <Border x:Name="Bar2" Width="2" Height="14" Background="{StaticResource AccentGreenBrush}" CornerRadius="1" Margin="1,0" />
            <Border x:Name="Bar3" Width="2" Height="6" Background="{StaticResource AccentGreenBrush}" CornerRadius="1" Margin="1,0" />
            <Border x:Name="Bar4" Width="2" Height="11" Background="{StaticResource AccentGreenBrush}" CornerRadius="1" Margin="1,0" />
          </StackPanel>
        </Grid>

        <!-- ================================================================= -->
        <!-- 2. EXPANDED VIEW STATE (Height=192, Width=444)                    -->
        <!-- ================================================================= -->
        <Grid x:Name="ExpandedContainer" Visibility="Collapsed" Margin="16,10,16,12">
          <Grid.RowDefinitions>
            <!-- Top Segmented Navigation Bar -->
            <RowDefinition Height="32" />
            <!-- Active Module Content -->
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- ==================== TOP NAVIGATION BAR ==================== -->
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <!-- iOS Segmented Control (Pill container) -->
            <Border Background="{StaticResource GlassSurfaceBrush}" CornerRadius="10" Padding="2"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabMedia" Content="Медиа" Style="{StaticResource AppleSegmentedRadioButton}"
                             IsChecked="True" Checked="Tab_Checked" />
                <RadioButton x:Name="TabSound" Content="Звук" Style="{StaticResource AppleSegmentedRadioButton}"
                             Checked="Tab_Checked" />
                <RadioButton x:Name="TabClock" Content="Часы" Style="{StaticResource AppleSegmentedRadioButton}"
                             Checked="Tab_Checked" />
                <RadioButton x:Name="TabWeather" Content="Погода" Style="{StaticResource AppleSegmentedRadioButton}"
                             Checked="Tab_Checked" />
                <RadioButton x:Name="TabPC" Content="ПК" Style="{StaticResource AppleSegmentedRadioButton}"
                             Checked="Tab_Checked" />
                <RadioButton x:Name="TabShelf" Content="Полка" Style="{StaticResource AppleSegmentedRadioButton}"
                             Checked="Tab_Checked" />
              </StackPanel>
            </Border>

            <!-- Right: Circular Settings Button -->
            <Button x:Name="BtnSettings" Width="26" Height="26" Style="{StaticResource AppleIconButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="MenuSettings_Click"
                    ToolTip="Настройки Dynamic Island">
              <Border Background="{StaticResource GlassSurfaceBrush}" CornerRadius="13" Width="26" Height="26">
                <Path Data="{StaticResource SettingsGearGeometry}" Fill="{StaticResource TextSecondaryBrush}"
                      Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Button>
          </Grid>

          <!-- ==================== MODULE 1: MEDIA PLAYER ==================== -->
          <Grid x:Name="ModuleMedia" Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Artwork + Titles + Live Waveform -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- 64x64 Album Art (iOS Squircle CornerRadius=14) -->
              <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource GlassSurfaceBrush}"
                      BorderBrush="#25FFFFFF" BorderThickness="1" ClipToBounds="True" Margin="0,0,14,0">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" Color="Black" />
                </Border.Effect>
                <Image x:Name="ExpandedArt" Stretch="UniformToFill" />
              </Border>

              <!-- Track Details -->
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="ExpandedTitle" Text="Ничего не воспроизводится" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ExpandedArtist" Text="Запустите Spotify, Яндекс или браузер" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
              </StackPanel>

              <!-- 5-Bar Live Waveform Visualizer -->
              <StackPanel x:Name="ExpVisualizer" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ExpBar1" Width="3" Height="12" Background="{StaticResource AccentGreenBrush}" CornerRadius="1.5" Margin="1.5,0" />
                <Border x:Name="ExpBar2" Width="3" Height="22" Background="{StaticResource AccentGreenBrush}" CornerRadius="1.5" Margin="1.5,0" />
                <Border x:Name="ExpBar3" Width="3" Height="8" Background="{StaticResource AccentGreenBrush}" CornerRadius="1.5" Margin="1.5,0" />
                <Border x:Name="ExpBar4" Width="3" Height="18" Background="{StaticResource AccentGreenBrush}" CornerRadius="1.5" Margin="1.5,0" />
                <Border x:Name="ExpBar5" Width="3" Height="10" Background="{StaticResource AccentGreenBrush}" CornerRadius="1.5" Margin="1.5,0" />
              </StackPanel>
            </Grid>

            <!-- Row 1: iOS Scrubber Slider + Tabular Timestamps -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <ProgressBar x:Name="PlaybackProgress" Height="4" Maximum="100" Value="0"
                           Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource GlassSurfaceHoverBrush}"
                           BorderThickness="0">
                <ProgressBar.Resources>
                  <Style TargetType="Border"><Setter Property="CornerRadius" Value="2" /></Style>
                </ProgressBar.Resources>
              </ProgressBar>

              <Grid Grid.Row="1" Margin="0,4,0,0">
                <TextBlock x:Name="TextElapsed" Text="0:00" FontSize="10" FontWeight="Medium"
                           Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                <TextBlock x:Name="TextTotal" Text="0:00" FontSize="10" FontWeight="Medium"
                           Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
              </Grid>
            </Grid>

            <!-- Row 2: Centered Transport Controls -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <!-- Previous Button -->
              <Button x:Name="BtnPrev" Width="38" Height="38" Style="{StaticResource AppleIconButton}"
                      Margin="12,0" Click="BtnPrev_Click">
                <Path Data="{StaticResource PrevGeometry}" Fill="{StaticResource TextPrimaryBrush}" Width="15" Height="15" Stretch="Uniform" />
              </Button>

              <!-- Play / Pause Circular Primary Button -->
              <Button x:Name="BtnPlayPause" Style="{StaticResource ApplePrimaryCircleButton}"
                      Margin="12,0" Click="BtnPlayPause_Click">
                <Path x:Name="IconPlayPause" Data="{StaticResource PlayGeometry}" Fill="{StaticResource IslandPureBlackBrush}"
                      Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
              </Button>

              <!-- Next Button -->
              <Button x:Name="BtnNext" Width="38" Height="38" Style="{StaticResource AppleIconButton}"
                      Margin="12,0" Click="BtnNext_Click">
                <Path Data="{StaticResource NextGeometry}" Fill="{StaticResource TextPrimaryBrush}" Width="15" Height="15" Stretch="Uniform" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- ==================== MODULE 2: VOLUME CONTROL ==================== -->
          <Grid x:Name="ModuleSound" Grid.Row="1" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
              <!-- Top Row: Icon + Label + Percent -->
              <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="BtnMute" Width="32" Height="32" Style="{StaticResource AppleIconButton}" Margin="0,0,10,0" Click="BtnMute_Click">
                    <Border Background="{StaticResource GlassSurfaceBrush}" CornerRadius="16" Width="32" Height="32">
                      <Path x:Name="IconVolumeSpeaker" Data="{StaticResource VolumeWaveHighGeometry}"
                            Fill="{StaticResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                    </Border>
                  </Button>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Громкость системы" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="TextMuteStatus" Text="Вывод звука активен" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>

                <TextBlock x:Name="ExpPercent" Text="50%" FontSize="20" FontWeight="Bold"
                           Typography.NumeralAlignment="Tabular" Foreground="{StaticResource AccentGreenBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>

              <!-- iOS Volume Capsule Slider -->
              <Slider x:Name="ExpSlider" Style="{StaticResource AppleVolumeSlider}" Maximum="100" Value="50"
                      ValueChanged="ExpSlider_ValueChanged" Margin="0,0,0,12" />

              <!-- Quick Presets -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Mute" Style="{StaticResource ApplePresetPillButton}" Margin="4,0" Click="Preset_Click" Tag="0" />
                <Button Content="25%" Style="{StaticResource ApplePresetPillButton}" Margin="4,0" Click="Preset_Click" Tag="25" />
                <Button Content="50%" Style="{StaticResource ApplePresetPillButton}" Margin="4,0" Click="Preset_Click" Tag="50" />
                <Button Content="75%" Style="{StaticResource ApplePresetPillButton}" Margin="4,0" Click="Preset_Click" Tag="75" />
                <Button Content="100%" Style="{StaticResource ApplePresetPillButton}" Margin="4,0" Click="Preset_Click" Tag="100" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- ==================== MODULE 3: CLOCK & STOPWATCH ==================== -->
          <Grid x:Name="ModuleClock" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Apple Watch Digital Time & Russian Date -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock x:Name="TextBigTime" Text="12:00:00" FontSize="32" FontWeight="Bold"
                         Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
              <TextBlock x:Name="TextBigDate" Text="Среда, 18 ноября 2026" FontSize="12" Margin="0,4,0,0"
                         Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Divider -->
            <Border Grid.Column="1" Width="1" Margin="14,6" Background="{StaticResource GlassSurfaceHoverBrush}" />

            <!-- Right: Stopwatch with iOS Buttons -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="СЕКУНДОМЕР" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" HorizontalAlignment="Center" Margin="0,0,0,3" />
              <TextBlock x:Name="TextStopwatch" Text="00:00.0" FontSize="22" FontWeight="SemiBold"
                         Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="BtnSwStartPause" Content="Старт" Width="60" Height="28" FontSize="11" FontWeight="SemiBold"
                        Style="{StaticResource ApplePresetPillButton}" Background="{StaticResource AccentGreenBrush}"
                        Foreground="{StaticResource IslandPureBlackBrush}" BorderThickness="0" Margin="4,0"
                        Click="BtnSwStartPause_Click" />
                <Button x:Name="BtnSwReset" Content="Сброс" Width="60" Height="28" FontSize="11" FontWeight="SemiBold"
                        Style="{StaticResource ApplePresetPillButton}" Margin="4,0" Click="BtnSwReset_Click" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- ==================== MODULE 4: WEATHER ==================== -->
          <Grid x:Name="ModuleWeather" Grid.Row="1" Visibility="Collapsed">
            <!-- Bento Card -->
            <Border Background="{StaticResource GlassSurfaceBrush}" CornerRadius="18" Padding="18,12">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Weather Vector Icon / Glyph -->
                <Path Data="{StaticResource WeatherSunCloudGeometry}" Fill="{StaticResource AccentBlueBrush}"
                      Width="46" Height="46" Stretch="Uniform" Margin="0,0,16,0" VerticalAlignment="Center" />

                <!-- Details -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TextExpTemp" Text="+18°" FontSize="34" FontWeight="Light"
                               Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="TextCity" Text="Москва • Ясно" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="12,12,0,0" />
                  </StackPanel>
                  <TextBlock x:Name="TextDesc" Text="Без осадков, влажность 65%" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Circular Refresh Button -->
                <Button x:Name="BtnRefresh" Grid.Column="2" Width="32" Height="32" Style="{StaticResource AppleIconButton}"
                        VerticalAlignment="Center" Click="BtnRefresh_Click">
                  <Border Background="{StaticResource GlassSurfaceHoverBrush}" CornerRadius="16" Width="32" Height="32">
                    <Path Data="{StaticResource RefreshGeometry}" Fill="{StaticResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                  </Border>
                </Button>
              </Grid>
            </Border>
          </Grid>

          <!-- ==================== MODULE 5: PC TELEMETRY ==================== -->
          <Grid x:Name="ModulePC" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CPU Bento Card -->
            <Border Grid.Column="0" Background="{StaticResource GlassSurfaceBrush}" CornerRadius="16" Padding="12,10" Margin="0,0,5,0">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="CPU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="TextExpCpu" Text="12%" FontSize="22" FontWeight="Bold"
                           Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4" />
                <ProgressBar x:Name="BarCpu" Height="4" Width="82" Maximum="100" Value="12"
                             Foreground="{StaticResource AccentPurpleBrush}" Background="{StaticResource GlassSurfaceHoverBrush}" BorderThickness="0">
                  <ProgressBar.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="2" /></Style></ProgressBar.Resources>
                </ProgressBar>
              </StackPanel>
            </Border>

            <!-- RAM Bento Card -->
            <Border Grid.Column="1" Background="{StaticResource GlassSurfaceBrush}" CornerRadius="16" Padding="12,10" Margin="3,0,3,0">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="TextExpRam" Text="48%" FontSize="22" FontWeight="Bold"
                           Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4" />
                <ProgressBar x:Name="BarRam" Height="4" Width="82" Maximum="100" Value="48"
                             Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource GlassSurfaceHoverBrush}" BorderThickness="0">
                  <ProgressBar.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="2" /></Style></ProgressBar.Resources>
                </ProgressBar>
              </StackPanel>
            </Border>

            <!-- Battery Bento Card -->
            <Border Grid.Column="2" Background="{StaticResource GlassSurfaceBrush}" CornerRadius="16" Padding="12,10" Margin="5,0,0,0">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="LabelBattery" Text="BAT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="TextExpBattery" Text="100%" FontSize="22" FontWeight="Bold"
                           Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4" />
                <ProgressBar x:Name="BarBattery" Height="4" Width="82" Maximum="100" Value="100"
                             Foreground="{StaticResource AccentGreenBrush}" Background="{StaticResource GlassSurfaceHoverBrush}" BorderThickness="0">
                  <ProgressBar.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="2" /></Style></ProgressBar.Resources>
                </ProgressBar>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ==================== MODULE 6: FILE SHELF ==================== -->
          <Grid x:Name="ModuleShelf" Grid.Row="1" Visibility="Collapsed">
            <Border Background="#141416" BorderBrush="{StaticResource GlassSurfaceHoverBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                  <TextBlock Text="ВРЕМЕННАЯ ПОЛКА" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                  <Button x:Name="BtnClearAll" Content="Очистить" Style="{StaticResource AppleIconButton}"
                          FontSize="10.5" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right" Click="BtnClearAll_Click" />
                </Grid>

                <Grid Grid.Row="1">
                  <!-- Dashed Dropzone Prompt -->
                  <Border x:Name="DropPrompt" BorderBrush="{StaticResource GlassSurfaceHoverBrush}" BorderThickness="1"
                          CornerRadius="12" Background="Transparent" Margin="2">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <Path Data="{StaticResource FolderIconGeometry}" Fill="{StaticResource TextSecondaryBrush}"
                            Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />
                      <TextBlock Text="Перетащите файлы сюда для быстрого доступа" FontSize="11"
                                 Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>

                  <!-- List of Dropped Files -->
                  <ListBox x:Name="ListFiles" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="📄" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Content="Копия" Style="{StaticResource ApplePresetPillButton}"
                                  Height="22" Margin="4,0" Click="BtnCopyFile_Click" Tag="{Binding Path}" />
                          <Button Grid.Column="3" Content="Открыть" Style="{StaticResource ApplePresetPillButton}"
                                  Height="22" Margin="2,0" Click="BtnOpenFile_Click" Tag="{Binding Path}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Grid>
            </Border>
          </Grid>

        </Grid>

      </Grid>
    </Border>

  </Grid>
</Window>
